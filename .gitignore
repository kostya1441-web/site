# Локальные настройки с реквизитами эквайринга
/config/config.local.php

# Логи и кэш
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# Загруженные картинки товаров
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/.gitkeep

# Служебное
/node_modules
.DS_Store
*.log
