# Force index.php to win if a stray index.html ever ends up in the same
# folder (e.g. from also uploading the static export) — otherwise Apache's
# default DirectoryIndex order serves the old static homepage instead of
# routing through the PHP app.
DirectoryIndex index.php

# Raise the default upload limit (many hosts ship 2M, too small for a
# real photo) — only takes effect where PHP runs as an Apache module;
# harmless no-op otherwise. PHP-FPM hosts pick up .user.ini instead.
<IfModule mod_php.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 14M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 14M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 14M
</IfModule>

RewriteEngine On

# Serve real files/directories (assets, uploads, admin/*.php) as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller, which resolves the
# path against the pages/case_studies/articles tables.
RewriteRule ^ index.php [L]
